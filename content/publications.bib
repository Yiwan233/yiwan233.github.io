@article{yi2026deephedging,
  title = {Deep Hedging under Rough Volatility: A Fractional Kernel Embedding Approach},
  author = {Fan Yi},
  year = {2026},
  note = {Submitted Mar 2026; Major Revision received May 2026 at AIMS Mathematics},
  abstract = {Addressed the non-Markovian long-memory characteristics of rough volatility models (H in (0, 1/2)), revealing the structural operator mismatch in generic deep learning architectures. Proposed a novel architecture embedding fractional kernel inductive biases, transforming ill-posed singular operator learning into well-posed smooth process approximation via fixed fractional attention layers.},
  keywords = {Mathematical Finance, Rough Volatility, Deep Hedging, Malliavin Calculus}
}
