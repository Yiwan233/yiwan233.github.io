@article{fan2026deephedging,
  title = {Deep Hedging under Rough Volatility: A Fractional Kernel Embedding Approach},
  author = {Yi Fan and Xujiang Tang and Runsen Guan},
  journal = {AIMS Mathematics},
  year = {2026},
  note = {Accepted. Co-first and corresponding author.},
  abstract = {Studies hedging under rough volatility, where the volatility process is non-Markovian with long memory (H in (0, 1/2)). Using Malliavin calculus, the hedge is decomposed so that the singular fractional kernel is fixed and a neural network only approximates the regular part, giving an architecture with a fractional-kernel inductive bias. Under a stated assumption on the network approximation error, the paper derives a conditional O(N^{-2H}) convergence result over N rebalancing dates, consistent with the known strong-approximation order barrier for Volterra-type models.},
  keywords = {Mathematical Finance, Rough Volatility, Deep Hedging, Malliavin Calculus},
  selected = {true}
}

@inproceedings{luo2026forcesafety,
  title = {Force Safety by Geometry: Equivalent Displacement Manifolds for Autonomous Ultrasound Scanning},
  author = {Jiayuan Luo and Yizhao Qian and Yi Fan and Ge Yang and Heng Tang and Li Liu},
  booktitle = {IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS)},
  year = {2026},
  note = {Accepted. My role: experimental data processing, statistical analysis and visualization.},
  abstract = {Proposes a safety-by-construction framework for autonomous robotic ultrasound scanning that encodes contact-force constraints as geometric properties of the workspace, through an Equivalent Displacement Manifold determined by tissue stiffness and a conformal map to a canonical plane where a scanning policy is trained.},
  keywords = {Robotics, Medical Robotics, Autonomous Ultrasound, Force Safety},
  selected = {true}
}
